@using PundoPH.Service

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject Service Service
@inject HttpClient Http

<button class="oi oi-document btn btn-outline-primary" @onclick="DownloadExcel"> xls</button>
<button class="oi oi-document btn btn-outline-danger" @onclick="DownloadPdf"> pdf</button>

@code {
    private async Task DownloadExcel()
    {
        var token = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "Token");
        if (!string.IsNullOrEmpty(token))
        {
            var fileName = "ContributionReport.xlsx";
            var contributions = await Service.Contribution.GetContribution();
            await Service.Export.Excel(fileName, contributions);
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task DownloadPdf()
    {
        var token = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "Token");
        if (!string.IsNullOrEmpty(token))
        {
            string fileName = "ContributionReport.pdf";
            var contributions = await Service.Contribution.GetContribution();
            await Service.Export.Pdf(contributions, fileName);
        }
        else
        {
            NavigationManager.NavigateTo("/");
        }
    }
}
